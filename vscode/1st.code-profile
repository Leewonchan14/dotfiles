{"name":"1st","settings":"{\"settings\":\"{\\n  \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', 'D2Coding', 'JetBrains Mono'\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.tabSize\\\": 2,\\n  \\\"editor.renderWhitespace\\\": \\\"all\\\",\\n\\n  // Cursor Setting\\n  \\\"editor.cursorWidth\\\": 3,\\n  \\\"editor.cursorBlinking\\\": \\\"expand\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.minimap.enabled\\\": true,\\n  \\\"editor.minimap.showSlider\\\": \\\"always\\\",\\n  \\\"editor.hover.enabled\\\": \\\"on\\\",\\n  \\\"editor.find.cursorMoveOnType\\\": false,\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n  \\\"editor.quickSuggestions\\\": {\\n    \\\"other\\\": true,\\n    \\\"comments\\\": true,\\n    \\\"strings\\\": true,\\n  },\\n  \\\"editor.suggestOnTriggerCharacters\\\": true,\\n  \\\"editor.suggest.matchOnWordStartOnly\\\": false,\\n  \\\"editor.suggest.localityBonus\\\": true,\\n  \\\"editor.wordBasedSuggestions\\\": \\\"allDocuments\\\",\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n  \\\"editor.codeLens\\\": true,\\n\\n  /**\\n   * 2. 가이드라인 및 인레이 힌트 (Inlay Hints & Guides)\\n   */\\n  \\\"editor.inlayHints.enabled\\\": \\\"on\\\",\\n  \\\"editor.inlayHints.fontSize\\\": 16,\\n  \\\"editor.inlayHints.padding\\\": true,\\n  \\\"editor.inlayHints.fontFamily\\\": \\\"'D2Coding', 'JetBrains Mono', '배달의민족 도현', comic sans ms\\\",\\n  \\\"editor.guides.bracketPairs\\\": true,\\n  \\\"editor.guides.indentation\\\": true,\\n  \\\"editor.renderLineHighlight\\\": \\\"all\\\",\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n\\n  /**\\n   * 3. 워크벤치 및 인터페이스 (Workbench & UI)\\n   */\\n  \\\"workbench.iconTheme\\\": \\\"vscode-icons\\\",\\n  \\\"workbench.colorCustomizations\\\": {\\n    // \\\"editorCursor.foreground\\\": \\\"#ffff00\\\",\\n    // \\\"editorCursor.background\\\": \\\"#00ff00\\\",\\n    \\\"editorInlayHint.background\\\": \\\"#282c34\\\",\\n    \\\"editorInlayHint.foreground\\\": \\\"#abb2bf\\\",\\n    \\\"editorCursor.foreground\\\": \\\"#ff6b9d\\\",\\n    \\\"editorCursor.background\\\": \\\"#ff6b9d33\\\",\\n  },\\n  \\\"editor.tokenColorCustomizations\\\": {\\n    \\\"textMateRules\\\": [\\n      {\\n        \\\"name\\\": \\\"예약어 이태릭하기\\\",\\n        \\\"scope\\\": [\\n          \\\"storage.type\\\",\\n          \\\"storage.modifier\\\",\\n          \\\"keyword.control\\\",\\n          \\\"keyword.operator.export\\\",\\n          \\\"keyword.operator.import\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"fontStyle\\\": \\\"italic\\\",\\n        },\\n      },\\n    ],\\n  },\\n  // 📂 에디터 탭에 부모 폴더 이름 표시 (index.ts 파일 구분용)\\n  \\\"workbench.editor.customLabels.patterns\\\": {\\n    \\\"**/**/index.{js,jsx,ts,tsx}\\\": \\\"${dirname}\\\",\\n  },\\n  \\\"vsicons.associations.files\\\": [\\n    {\\n      \\\"icon\\\": \\\"reacttemplate\\\", // 또는 눈에 잘 띄는 다른 아이콘 이름\\n      \\\"extensions\\\": [\\\"index.tsx\\\", \\\"index.jsx\\\"],\\n      \\\"filename\\\": true,\\n      \\\"format\\\": \\\"svg\\\",\\n    },\\n    // {\\n    //   \\\"icon\\\": \\\"jshint\\\",\\n    //   \\\"extensions\\\": [\\\"index.ts\\\", \\\"index.js\\\"],\\n    //   \\\"filename\\\": true,\\n    //   \\\"format\\\": \\\"svg\\\",\\n    // },\\n  ],\\n\\n  \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n  \\\"workbench.editor.editorActionsLocation\\\": \\\"titleBar\\\",\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n\\n  /**\\n   * 4. 파일 및 검색 설정 (Files & Search)\\n   */\\n  \\\"files.associations\\\": {\\n    \\\"docker-compose.y*ml\\\": \\\"yaml\\\",\\n  },\\n  \\\"search.useIgnoreFiles\\\": false,\\n  \\\"search.quickAccess.preserveInput\\\": true,\\n  \\\"search.quickOpen.includeHistory\\\": false,\\n  \\\"search.exclude\\\": {\\n    \\\"**/node_modules\\\": true,\\n    \\\"**/bower_components\\\": true,\\n    \\\"**/*.code-search\\\": true,\\n    \\\"**/.next\\\": true,\\n    \\\"**/dist\\\": true,\\n    \\\"**/.venv\\\": true,\\n    \\\"**/__pycache__\\\": true,\\n  },\\n  \\\"typescript.tsserver.maxTsServerMemory\\\": 8192, // TS 서버 메모리 제한 확장 (성능)\\n\\n  /**\\n   * 5. 터미널 설정 (Terminal)\\n   */\\n  \\\"terminal.integrated.defaultProfile.windows\\\": \\\"Git Bash\\\",\\n  \\\"terminal.integrated.defaultProfile.osx\\\": \\\"zsh\\\",\\n  \\\"terminal.integrated.fontFamily\\\": \\\"'MesloLGS NF', 'JetBrains Mono'\\\",\\n  \\\"terminal.integrated.cursorBlinking\\\": true,\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"line\\\",\\n  \\\"terminal.integrated.scrollback\\\": 1000000000000,\\n  \\\"terminal.integrated.enablePersistentSessions\\\": true,\\n  \\\"terminal.integrated.localEchoEnabled\\\": \\\"on\\\",\\n  \\\"terminal.integrated.enableImages\\\": true,\\n  \\\"terminal.integrated.macOptionIsMeta\\\": true,\\n  \\\"terminal.integrated.wordSeparators\\\": \\\"()[]{}',\\\\\\\"`─‘’“”|\\\",\\n  \\\"terminal.integrated.profiles.osx\\\": {\\n    \\\"bash\\\": null,\\n    \\\"tmux\\\": {\\n      \\\"path\\\": \\\"zsh\\\",\\n      \\\"args\\\": [\\\"-c\\\", \\\"/opt/homebrew/bin/tmux\\\"],\\n      \\\"icon\\\": \\\"terminal-tmux\\\",\\n      \\\"overrideName\\\": true,\\n    },\\n  },\\n  \\\"terminal.integrated.env.linux\\\": {\\n    \\\"FIG_NEW_SESSION\\\": \\\"1\\\",\\n    \\\"Q_NEW_SESSION\\\": \\\"1\\\",\\n    \\\"VSCODE_SHELL_INTEGRATION\\\": \\\"1\\\",\\n  },\\n  \\\"terminal.integrated.automationProfile.osx\\\": {\\n    \\\"path\\\": \\\"/bin/zsh\\\",\\n  },\\n\\n  /**\\n   * 6. 언어별 포맷팅 및 설정 (Language Specifics)\\n   */\\n  \\\"editor.formatOnSave\\\": false,\\n  \\\"editor.formatOnType\\\": true,\\n  \\\"diffEditor.wordWrap\\\": \\\"on\\\",\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n  \\\"diffEditor.renderSideBySide\\\": true,\\n\\n  \\\"[dotenv]\\\": { \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\" },\\n  \\\"[env]\\\": { \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\" },\\n  \\\"[jsonc]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[html]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[ignore]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[javascript]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[typescript]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[javascriptreact]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[typescriptreact]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[markdown]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[css]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[sql]\\\": { \\\"editor.defaultFormatter\\\": \\\"inferrinizzard.prettier-sql-vscode\\\" },\\n  \\\"[shellscript]\\\": { \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\" },\\n  \\\"[yaml]\\\": { \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\" },\\n  \\\"[github-actions-workflow]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\",\\n  },\\n  \\\"[json]\\\": { \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\" },\\n  \\\"[dockercompose]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-azuretools.vscode-containers\\\",\\n  },\\n  \\\"[dockerfile]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-azuretools.vscode-containers\\\",\\n  },\\n\\n  // Python\\n  \\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-python.black-formatter\\\",\\n    \\\"editor.formatOnType\\\": true,\\n  },\\n  \\\"python.analysis.inlayHints.callArgumentNames\\\": \\\"all\\\",\\n  \\\"python.analysis.inlayHints.functionReturnTypes\\\": true,\\n  \\\"python.analysis.inlayHints.pytestParameters\\\": true,\\n  \\\"python.analysis.inlayHints.variableTypes\\\": true,\\n  \\\"python.analysis.autoImportCompletions\\\": true,\\n  \\\"python.analysis.autoFormatStrings\\\": true,\\n  \\\"python.analysis.typeCheckingMode\\\": \\\"basic\\\",\\n  \\\"python.analysis.userFileIndexingLimit\\\": -1,\\n  \\\"python.terminal.activateEnvironment\\\": false,\\n\\n  // Java\\n  \\\"[java]\\\": { \\\"editor.defaultFormatter\\\": \\\"redhat.java\\\" },\\n  \\\"java.format.settings.profile\\\": \\\"GoogleStyle\\\",\\n  \\\"java.inlayHints.parameterNames.enabled\\\": \\\"all\\\",\\n  \\\"java.debug.settings.hotCodeReplace\\\": \\\"never\\\",\\n  \\\"java.gradle.buildServer.enabled\\\": \\\"off\\\",\\n\\n  // Others\\n  \\\"[groovy]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"NicolasVuillamy.vscode-groovy-lint\\\",\\n  },\\n  \\\"javascript.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n  \\\"typescript.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n  \\\"emmet.includeLanguages\\\": { \\\"javascript\\\": \\\"javascriptreact\\\" },\\n\\n  /**\\n   * 7. AI 및 확장 프로그램 설정 (AI & Extensions)\\n   */\\n  // GitHub Copilot & Gemini\\n  \\\"github.copilot.enable\\\": {\\n    \\\"*\\\": true,\\n    \\\"plaintext\\\": true,\\n    \\\"markdown\\\": false,\\n    \\\"scminput\\\": false,\\n  },\\n  \\\"github.copilot.editor.enableAutoCompletions\\\": true,\\n  \\\"geminicodeassist.inlineSuggestions.enableAuto\\\": false,\\n  \\\"geminicodeassist.displayInlineContextHint\\\": false,\\n\\n  // GitHub Pull Requests\\n  \\\"githubPullRequests.hosts\\\": [\\n    {\\n      \\\"host\\\": \\\"https://github.com\\\",\\n      \\\"isGitHubDotCom\\\": true,\\n    },\\n  ],\\n  \\\"githubPullRequests.remotes\\\": [\\\"origin\\\", \\\"upstream\\\"],\\n  \\\"githubPullRequests.queries\\\": [\\n    {\\n      \\\"label\\\": \\\"Local Pull Request Branches\\\",\\n      \\\"query\\\": \\\"default\\\",\\n    },\\n    {\\n      \\\"label\\\": \\\"Waiting For My Review\\\",\\n      \\\"query\\\": \\\"repo:${owner}/${repository} is:open review-requested:${user}\\\",\\n    },\\n    {\\n      \\\"label\\\": \\\"Created By Me\\\",\\n      \\\"query\\\": \\\"repo:${owner}/${repository} is:open author:${user}\\\",\\n    },\\n    {\\n      \\\"label\\\": \\\"All Open\\\",\\n      \\\"query\\\": \\\"default\\\",\\n    },\\n    {\\n      \\\"label\\\": \\\"Closed\\\",\\n      \\\"query\\\": \\\"repo:${owner}/${repository} is:closed\\\",\\n    },\\n  ],\\n\\n  // GitLens & Git\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.allowForcePush\\\": true,\\n  \\\"git.blame.statusBarItem.enabled\\\": true,\\n  \\\"gitlens.ai.model\\\": \\\"gitkraken\\\",\\n  \\\"gitlens.ai.gitkraken.model\\\": \\\"gemini:gemini-2.0-flash\\\",\\n  \\\"gitlens.graph.minimap.enabled\\\": false,\\n  \\\"gitlens.graph.layout\\\": \\\"editor\\\",\\n  \\\"git-graph.repository.fetchAndPrune\\\": true,\\n\\n  // Cursor & Pylance\\n  \\\"cursorpyright.analysis.inlayHints.callArgumentNames\\\": \\\"all\\\",\\n  \\\"cursorpyright.analysis.inlayHints.functionReturnTypes\\\": true,\\n  \\\"cursorpyright.analysis.inlayHints.variableTypes\\\": true,\\n  \\\"cursor.composer.shouldChimeAfterChatFinishes\\\": true,\\n  \\\"cursor.composer.usageSummaryDisplay\\\": \\\"always\\\",\\n\\n  // Background Image Settings\\n  \\\"background.enabled\\\": true,\\n  \\\"background.editor\\\": {\\n    \\\"useFront\\\": false,\\n    \\\"random\\\": true,\\n    \\\"interval\\\": 60,\\n    \\\"images\\\": [\\n      \\\"file:///Users/twoone14/Desktop/project/vscode-icon/duck.gif\\\",\\n      \\\"file:///Users/twoone14/Desktop/project/vscode-icon/rion.gif\\\",\\n      \\\"file:///Users/twoone14/Desktop/project/vscode-icon/jjangoo.gif\\\",\\n    ],\\n    \\\"style\\\": {\\n      \\\"content\\\": \\\"''\\\",\\n      \\\"pointer-events\\\": \\\"none\\\",\\n      \\\"position\\\": \\\"absolute\\\",\\n      \\\"right\\\": \\\"10%\\\",\\n      \\\"bottom\\\": \\\"0\\\",\\n      \\\"height\\\": \\\"300px\\\",\\n      \\\"z-index\\\": \\\"9999\\\",\\n      \\\"background-size\\\": \\\"contain\\\",\\n      \\\"opacity\\\": 0.8,\\n    },\\n  },\\n  \\\"background.panel\\\": {\\n    \\\"images\\\": [\\n      \\\"file:///Users/twoone14/Desktop/project/vscode-icon/panel-back.gif\\\",\\n    ],\\n    \\\"opacity\\\": 0.1,\\n    \\\"size\\\": \\\"cover\\\",\\n    \\\"position\\\": \\\"center\\\",\\n    \\\"interval\\\": 0,\\n    \\\"random\\\": false,\\n  },\\n\\n  // Custom CSS and JS Loader\\n  \\\"vscode_custom_css.imports\\\": [\\n    \\\"https://gist.githubusercontent.com/Leewonchan14/b2ccac03cf136b74745aee8ed2866d85/raw/4535567bc2f676075c65f5277c1c1b8a337caefd/index.js\\\",\\n  ],\\n  // \\\"vscode_custom_css.imports\\\": [\\n  //   \\\"file:///Users/twoone14/Desktop/project/ai-projects/browser/index.js\\\",\\n  // ],\\n\\n  // MetaGo\\n  \\\"metaGo.jumper.commandsToUseSingleTargetChar\\\": null,\\n\\n  /**\\n   * 8. 기타 유틸리티 (Misc)\\n   */\\n  //  Code Runner\\n  \\\"code-runner.saveAllFilesBeforeRun\\\": true,\\n  \\\"code-runner.runInTerminal\\\": true,\\n  \\\"code-runner.executorMap\\\": { \\\"python\\\": \\\"python3 -u\\\" },\\n\\n  // ErrorLens\\n  \\\"errorLens.fontWeight\\\": \\\"600\\\",\\n  \\\"errorLens.gutterIconSet\\\": \\\"circle\\\",\\n\\n  // Vim\\n  \\\"vim.smartRelativeLine\\\": true,\\n  \\\"vim.useSystemClipboard\\\": true,\\n\\n  // Prettier\\n  \\\"prettier.tabWidth\\\": 2,\\n  \\\"prettier.printWidth\\\": 80,\\n\\n  // Remote\\n  \\\"remote.SSH.localServerDownload\\\": \\\"off\\\",\\n  \\\"remote.SSH.lockfilesInTmp\\\": true,\\n\\n  // ShellFormat\\n  \\\"shellformat.path\\\": \\\"/opt/homebrew/bin/shfmt\\\",\\n\\n  // CSpell\\n  \\\"cSpell.userWords\\\": [\\\"dotenv\\\", \\\"functionals\\\", \\\"nodemon\\\", \\\"rgba\\\", \\\"typeorm\\\"],\\n\\n  // Postfix\\n  \\\"postfix.customTemplates\\\": [\\n    {\\n      \\\"name\\\": \\\"log\\\",\\n      \\\"description\\\": \\\"console.log()\\\",\\n      \\\"body\\\": \\\"console.log(\\\\\\\"{{expr}}: \\\\\\\", {{expr}});\\\",\\n      \\\"when\\\": [],\\n    },\\n  ],\\n  \\\"postfix.disabledBuiltinTemplates\\\": [\\\"log\\\"],\\n  \\\"window.zoomLevel\\\": -1,\\n  \\\"editor.fontSize\\\": 12.5,\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"terminal.integrated.smoothScrolling\\\": true,\\n  \\\"editor.cursorSurroundingLines\\\": 10,\\n  \\\"basedpyright.analysis.diagnosticMode\\\": \\\"workspace\\\",\\n  \\\"php.suggest.basic\\\": false,\\n  \\\"php.validate.enable\\\": false,\\n  \\\"emmet.excludeLanguages\\\": [\\\"markdown\\\", \\\"php\\\"],\\n  \\\"basedpyright.disableLanguageServices\\\": true,\\n  \\\"python.languageServer\\\": \\\"None\\\",\\n  \\\"git.blame.editorDecoration.enabled\\\": false,\\n  \\\"makefile.configureOnOpen\\\": true,\\n  \\\"copyPathWithLineNumber.show.message\\\": false,\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n}\\n\"}","keybindings":"{\"keybindings\":\"// 키 바인딩을 이 파일에 넣어서 기본값 재정의\\n[\\n  {\\n    \\\"command\\\": \\\"editor.action.triggerSuggest\\\",\\n    \\\"key\\\": \\\"alt+space\\\",\\n    \\\"when\\\": \\\"editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible\\\",\\n  },\\n  {\\n    \\\"command\\\": \\\"-editor.action.triggerSuggest\\\",\\n    \\\"key\\\": \\\"cmd+i\\\",\\n    \\\"when\\\": \\\"editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible\\\",\\n  },\\n  {\\n    \\\"command\\\": \\\"editor.action.triggerParameterHints\\\",\\n    \\\"key\\\": \\\"shift+alt+space\\\",\\n    \\\"when\\\": \\\"editorHasSignatureHelpProvider && editorTextFocus\\\",\\n  },\\n  {\\n    \\\"command\\\": \\\"-editor.action.triggerParameterHints\\\",\\n    \\\"key\\\": \\\"shift+cmd+space\\\",\\n    \\\"when\\\": \\\"editorHasSignatureHelpProvider && editorTextFocus\\\",\\n  },\\n  {\\n    \\\"command\\\": \\\"-editor.action.triggerSuggest\\\",\\n    \\\"key\\\": \\\"ctrl+space\\\",\\n    \\\"when\\\": \\\"editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+n\\\",\\n    \\\"command\\\": \\\"-workbench.action.files.newUntitledFile\\\",\\n  },\\n  {\\n    \\\"command\\\": \\\"explorer.newFile\\\",\\n    \\\"key\\\": \\\"cmd+n\\\",\\n    \\\"when\\\": \\\"!editorFocus && sideBarFocus\\\",\\n  },\\n  {\\n    \\\"command\\\": \\\"explorer.newFolder\\\",\\n    \\\"key\\\": \\\"cmd+shift+n\\\",\\n    \\\"when\\\": \\\"!editorFocus && sideBarFocus\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+c\\\",\\n    \\\"command\\\": \\\"merge-conflict.next\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+c\\\",\\n    \\\"command\\\": \\\"merge-conflict.previous\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+\\\\\\\\\\\",\\n    \\\"command\\\": \\\"extension.matchitSelectItems\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+r\\\",\\n    \\\"command\\\": \\\"-workbench.action.keybindingsReference\\\",\\n  },\\n\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"-workbench.view.debug\\\",\\n    \\\"when\\\": \\\"viewContainer.workbench.view.debug.enabled\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"editor.action.addSelectionToPreviousFindMatch\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+g\\\",\\n    \\\"command\\\": \\\"-editor.action.previousMatchFindAction\\\",\\n    \\\"when\\\": \\\"editorFocus\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+g\\\",\\n    \\\"command\\\": \\\"workbench.view.scm\\\",\\n    \\\"when\\\": \\\"workbench.scm.active\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+g\\\",\\n    \\\"command\\\": \\\"-workbench.view.scm\\\",\\n    \\\"when\\\": \\\"workbench.scm.active\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+l\\\",\\n    \\\"command\\\": \\\"-editor.toggleFold\\\",\\n    \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+l\\\",\\n    \\\"command\\\": \\\"editor.createFoldingRangeFromSelection\\\",\\n    \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+,\\\",\\n    \\\"command\\\": \\\"-editor.createFoldingRangeFro